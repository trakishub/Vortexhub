	TweenService:Create(
		Bar,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = UDim2.new(i / 100, 0, 1, 0)}
	):Play()

	task.wait(0.045)
