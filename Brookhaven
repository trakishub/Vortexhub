--// Serviços necessários
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--// Remove se já existir um aviso anterior para evitar duplicados
pcall(function()
    local old = CoreGui:FindFirstChild("VortexWarningGui")
    if old then old:Destroy() end
    local oldPlayerGui = PlayerGui:FindFirstChild("VortexWarningGui")
    if oldPlayerGui then oldPlayerGui:Destroy() end
end)

--// Criação da ScreenGui principal
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VortexWarningGui"
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999999
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui -- Usa CoreGui para ficar acima de tudo

--// Fundo escuro com efeito de desfoque/blur leve
local darkOverlay = Instance.new("Frame")
darkOverlay.Size = UDim2.fromScale(1, 1)
darkOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
darkOverlay.BackgroundTransparency = 1
darkOverlay.BorderSizePixel = 0
darkOverlay.Parent = screenGui

--// Janela principal do aviso (Design moderno com borda RGB/Neon)
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 480, 0, 240)
mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
mainFrame.BackgroundTransparency = 0.1
mainFrame.BorderSizePixel = 0
mainFrame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = mainFrame

--// Borda com gradiente / efeito brilhante
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(170, 45, 255)
stroke.Thickness = 2.5
stroke.Parent = mainFrame

--// Gradiente interno para dar um toque sofisticado
local gradient = Instance.new("UIGradient")
gradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 20, 60)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 22))
})
gradient.Rotation = 45
gradient.Parent = mainFrame

--// Título "ATENÇÃO"
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -40, 0, 40)
titleLabel.Position = UDim2.new(0, 20, 0, 20)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "⚠️ ATENÇÃO ⚠️"
titleLabel.TextColor3 = Color3.fromRGB(225, 130, 255)
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 22
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Parent = mainFrame

--// Texto da mensagem
local msgLabel = Instance.new("TextLabel")
msgLabel.Size = UDim2.new(1, -40, 0, 120)
msgLabel.Position = UDim2.new(0, 20, 0, 70)
msgLabel.BackgroundTransparency = 1
msgLabel.Text = "Esse script foi acabado de você está lendo isso saiba que o script não será continuado pq eu e o 2 dono acabamos brigando mais espero que um dia voltamos a amizade 🙁 "
msgLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
msgLabel.Font = Enum.Font.GothamMedium
msgLabel.TextSize = 15
msgLabel.TextWrapped = true
msgLabel.TextXAlignment = Enum.TextXAlignment.Left
msgLabel.TextYAlignment = Enum.TextYAlignment.Top
msgLabel.Parent = mainFrame

--// Animação de Entrada (Surgindo suavemente com efeito de escala/back)
mainFrame.Size = UDim2.new(0, 0, 0, 0)
darkOverlay.BackgroundTransparency = 1

TweenService:Create(darkOverlay, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {
    BackgroundTransparency = 0.5
}):Play()

TweenService:Create(mainFrame, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 480, 0, 240)
}):Play()

--// Mantém a mensagem na tela durante 10 segundos  (10) e depois faz o fade out
task.delay(10, function()
    if screenGui and screenGui.Parent then
        -- Animação de saída
        TweenService:Create(darkOverlay, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
            BackgroundTransparency = 1
        }):Play()

        local sai = TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        sai:Play()
        sai.Completed:Wait()

        screenGui:Destroy()
    end
end)
