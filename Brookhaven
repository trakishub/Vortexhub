local rng = Random.new()

local function createFloatingParticle()
	local particle = Instance.new("Frame")

	local size = rng:NextInteger(2, 6)

	particle.Size = UDim2.fromOffset(size, size)
	particle.Position = UDim2.fromScale(
		rng:NextNumber(),
		rng:NextNumber()
	)
	particle.AnchorPoint = Vector2.new(0.5, 0.5)
	particle.BackgroundColor3 = PURPLE_BRIGHT
	particle.BackgroundTransparency = rng:NextNumber(0.25, 0.75)
	particle.BorderSizePixel = 0
	particle.ZIndex = 3
	particle.Parent = Background

	corner(particle, 999)

	local glow = Instance.new("UIStroke")
	glow.Color = PURPLE
	glow.Thickness = rng:NextNumber(1, 2.5)
	glow.Transparency = 0.45
	glow.Parent = particle

	task.spawn(function()
		while particle.Parent do
			local targetX = math.clamp(
				particle.Position.X.Scale + rng:NextNumber(-0.12, 0.12),
				-0.05,
				1.05
			)

			local targetY = math.clamp(
				particle.Position.Y.Scale + rng:NextNumber(-0.12, 0.12),
				-0.05,
				1.05
			)

			local targetSize = rng:NextInteger(2, 7)

			local tween = TweenService:Create(
				particle,
				TweenInfo.new(
					rng:NextNumber(2.5, 5.5),
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.fromScale(targetX, targetY),
					Size = UDim2.fromOffset(targetSize, targetSize),
					BackgroundTransparency = rng:NextNumber(0.2, 0.82)
				}
			)

			tween:Play()
			tween.Completed:Wait()
		end
	end)

	task.spawn(function()
		while particle.Parent do
			TweenService:Create(
				glow,
				TweenInfo.new(
					rng:NextNumber(0.8, 1.6),
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Transparency = rng:NextNumber(0.15, 0.8)
				}
			):Play()

			task.wait(rng:NextNumber(0.8, 1.6))
		end
	end)
end

for _ = 1, 65 do
